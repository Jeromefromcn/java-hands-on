<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.jerome.slledger</groupId>
    <artifactId>sl-ledger-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>domain</artifactId>
  <name>Domain</name>
  <description>Entities, value objects and domain services. No third-party dependencies, ever.</description>

  <dependencies>
    <!-- Test scope only. The enforcer rule below permits exactly this and
         nothing else: the tests may use a framework, the production code
         may not. Versions come from the imported Spring Boot BOM.

         Deliberately not spring-boot-starter-test: it puts Spring on the
         test classpath of the one module whose premise is that Spring is
         not there. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <!-- The rule this whole stage exists for. domain holds the money
                 arithmetic and the invariants; a framework annotation on a
                 domain type is how those invariants start depending on a
                 release cycle that is not ours. Stated in prose it survives
                 about three stages, so it is stated as a build failure. -->
            <id>enforce-domain-has-no-third-party-dependencies</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <!-- Test-scoped only: the tests may use a framework,
                         the production code may not. -->
                    <include>*:*:*:*:test</include>
                  </includes>
                  <message>
                    domain takes no third-party dependency outside test scope.
                    If a domain type needs one, the need belongs in
                    application or an adapter instead.
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
