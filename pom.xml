<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.jerome.slledger</groupId>
  <artifactId>sl-ledger-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Securities Lending Ledger</name>
  <description>
    A securities-lending ledger, built one stage at a time to exercise Java,
    Spring and the JVM. Aggregator and single source of dependency versions.
  </description>

  <modules>
    <module>domain</module>
    <module>application</module>
    <module>adapter-persistence</module>
    <module>adapter-web</module>
    <module>adapter-messaging</module>
    <module>batch</module>
    <module>bootstrap</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Java 21 LTS. Virtual threads and pattern matching are stable here;
         Java 25 features are exercised separately in stage 8. -->
    <maven.compiler.release>21</maven.compiler.release>

    <!-- The Spring Boot BOM is imported, never inherited as a parent POM:
         in a regulated environment the parent POM is the organisation's own,
         so importing is the only shape that survives contact with reality. -->
    <spring-boot.version>4.1.1</spring-boot.version>

    <!-- Stage 13: security patch releases over the Boot BOM; see the dependencyManagement
         entries that use them. -->
    <tomcat.version>11.0.25</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <jackson-2-bom.version>2.21.7</jackson-2-bom.version>

    <!-- Every plugin version is pinned here. An unpinned plugin resolves
         RELEASE from central, so the build changes when someone else ships,
         and the recorded jar checksums stop meaning anything. -->
    <maven-clean-plugin.version>3.4.1</maven-clean-plugin.version>
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    <maven-site-plugin.version>3.21.0</maven-site-plugin.version>
    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    <!-- Stage 13: copy-dependencies, for infra/security/scan.sh. Not bound to any phase. -->
    <maven-dependency-plugin.version>3.9.0</maven-dependency-plugin.version>
    <!-- Failsafe and Surefire ship from the same Maven Surefire project, in
         lockstep. -->
    <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
    <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
    <spotless.version>3.10.2</spotless.version>
    <google-java-format.version>1.36.1</google-java-format.version>

    <!-- Not managed by the imported Spring Boot BOM, so pinned here like
         every other version in this file. -->
    <archunit.version>1.5.0</archunit.version>
    <cucumber.version>7.20.1</cucumber.version>
    <!-- Stage 7. springdoc's 3.x line is built against Boot 4; the -api
         artifact serves the document without the browser UI. -->
    <springdoc.version>3.1.1</springdoc.version>
    <!-- Stage 7, test only: validates real responses against the served
         OpenAPI document. -->
    <swagger-request-validator.version>3.0.0</swagger-request-validator.version>
    <!-- Stage 12: the core libraries only (circuit breaker, bulkhead, rate
         limiter, Micrometer binders), wired in code. Not managed by the Spring
         Boot BOM; its own BOM is imported below. -->
    <resilience4j.version>2.3.0</resilience4j.version>

    <!-- spring-boot-dependencies (the import-scope BOM above) manages
         dependency versions only, not plugin versions — that pluginManagement
         block lives in spring-boot-starter-parent, which this project
         deliberately does not inherit. So the plugin gets its own pin, kept
         equal to spring-boot.version since they ship together. -->
    <spring-boot-maven-plugin.version>${spring-boot.version}</spring-boot-maven-plugin.version>

    <!-- Fixed timestamp for reproducible builds: two clean packages must
         produce byte-identical jars. Verified in section 8. -->
    <project.build.outputTimestamp>2026-09-20T00:00:00Z</project.build.outputTimestamp>

    <!-- Build output directory name, per module. Command-line builds use
         target; the m2e profile below switches IDE builds to target-ide.
         See the m2e profile for why. -->
    <build.directory.name>target</build.directory.name>

    <!-- JUnit tags Failsafe leaves out. "measurement" marks tests whose job is
         to produce numbers for a decision record (crossover timings,
         throughput, EXPLAIN at volume): they assert correctness too, but take
         minutes, and their numbers are only worth taking on purpose. The
         measure profile below runs them. -->
    <it.excludedGroups>measurement</it.excludedGroups>
  </properties>

  <!-- The single source of every version, internal and third-party alike.
       Child POMs declare dependencies without a <version>. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>adapter-persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>adapter-persistence</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>adapter-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>adapter-messaging</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>adapter-messaging</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>batch</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>bootstrap</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- Stage 13: patch releases of the libraries the Spring Boot BOM pins at versions that
           infra/security/scan.sh reports with fixed HIGH or CRITICAL vulnerabilities (Tomcat, and
           Jackson 2 and 3). They sit BEFORE the Boot import: of two imports that manage the same
           artifact, the first wins, and an override placed after it would change nothing. Drop each
           when the Boot BOM catches up (the scan says when: a version below the BOM's is a
           downgrade). See docs/decisions/13-security.md. -->
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-2-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>${tomcat.version}</version>
      </dependency>

      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-bom</artifactId>
        <version>${resilience4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Mockito comes in through mockito-bom, transitively imported by
           spring-boot-dependencies above; junit-platform-suite comes in the
           same way via junit-bom. Neither needs an entry here. ArchUnit and
           Cucumber are not managed by either BOM. -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-java</artifactId>
        <version>${cucumber.version}</version>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-junit-platform-engine</artifactId>
        <version>${cucumber.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.atlassian.oai</groupId>
        <artifactId>swagger-request-validator-core</artifactId>
        <version>${swagger-request-validator.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <directory>${project.basedir}/${build.directory.name}</directory>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven-site-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>

        <plugin>
          <!-- Architecture rules, not unit tests: bound to the
               integration-test/verify phases, not surefire's test phase, so
               they stay out of the fast inner loop. Classes must be named
               *IT for Failsafe's default inclusion pattern to pick them up. -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <excludedGroups>${it.excludedGroups}</excludedGroups>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
          <executions>
            <execution>
              <id>jacoco-prepare-agent</id>
              <phase>initialize</phase>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>jacoco-report</id>
              <phase>test</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <compilerArgs>
              <!-- Every warning the compiler has, and no warning survives a
                   build: a warning nobody fails on is a warning nobody reads. -->
              <arg>-Xlint:all</arg>
              <arg>-Werror</arg>
            </compilerArgs>
            <!-- Stage 7: Spring MVC binds @PathVariable and @RequestParam by
                 parameter name. spring-boot-starter-parent turns this on;
                 this project does not inherit it, so it is set here. Without
                 it, every unnamed binding fails at request time with a 500,
                 not at build time. -->
            <parameters>true</parameters>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
          <executions>
            <execution>
              <id>enforce-build-rules</id>
              <phase>validate</phase>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <rules>
                  <requireJavaVersion>
                    <version>[21,22)</version>
                    <message>
                      Build with JDK 21. A newer JDK is not a drop-in here:
                      stage 8 compares a newer JVM against this baseline, so
                      the baseline has to stay fixed.
                    </message>
                  </requireJavaVersion>
                  <requireMavenVersion>
                    <!-- Upper bound on purpose: Maven 4 changes the default
                         lifecycle plugin versions, which moves the artifacts
                         this stage measured. -->
                    <version>[3.9.0,4.0.0)</version>
                  </requireMavenVersion>
                  <requirePluginVersions>
                    <banLatest>true</banLatest>
                    <banRelease>true</banRelease>
                    <banSnapshots>true</banSnapshots>
                  </requirePluginVersions>
                  <requireReleaseDeps>
                    <message>No SNAPSHOT dependencies.</message>
                    <!-- This project's own modules are a SNAPSHOT until it
                         releases; the rule is about depending on someone
                         else's moving target. -->
                    <excludes>
                      <exclude>${project.groupId}:*</exclude>
                    </excludes>
                  </requireReleaseDeps>
                  <dependencyConvergence />
                  <banDuplicatePomDependencyVersions />
                </rules>
                <fail>true</fail>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot-maven-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <googleJavaFormat>
                <version>${google-java-format.version}</version>
              </googleJavaFormat>
              <removeUnusedImports />
              <importOrder />
            </java>
          </configuration>
          <executions>
            <execution>
              <!-- Bound to validate, not left as a goal someone remembers to
                   run: a formatting rule that only fires on request is a
                   suggestion. -->
              <id>spotless-check</id>
              <phase>validate</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- IDE builds get their own output directory. Eclipse m2e, and so the
           VS Code Java extension built on it, compiles in the background
           with ECJ into the build directory it reads from this POM. ECJ
           writes class files even for sources that do not compile, and
           Maven's incremental compile then takes those class files as up to
           date. Sharing target/ with a command-line build made ./mvnw verify
           run classes that threw "Unresolved compilation problems"
           (stage 5). m2e sets the m2e.version property on every build it
           runs; the command line never does, so CLI and CI keep target/.
           Workaround from the vscode-java maintainers:
           https://github.com/redhat-developer/vscode-java/issues/1381 -->
      <id>m2e</id>
      <activation>
        <property>
          <name>m2e.version</name>
        </property>
      </activation>
      <properties>
        <build.directory.name>target-ide</build.directory.name>
      </properties>
    </profile>

    <profile>
      <!-- The default. It carries nothing yet on purpose: a profile that
           exists to look symmetrical is a place for differences to hide.
           It is here so that `local` is a name the build knows, and so
           local-only conveniences have somewhere to land later. -->
      <id>local</id>
      <activation>
        <!-- Not activeByDefault: Maven switches that off the moment any other
             profile in this POM activates, which would make this profile
             disappear exactly when someone finally puts something in it. -->
        <property>
          <name>env.CI</name>
          <!-- Anything that is not exactly true, including CI being unset. -->
          <value>!true</value>
        </property>
      </activation>
    </profile>

    <profile>
      <!-- ./mvnw verify -Pmeasure: the gate plus every "measurement" test.
           Run it when a decision record's numbers are being taken, then copy
           target/evidence/ into docs/evidence/ by hand. -->
      <id>measure</id>
      <properties>
        <it.excludedGroups></it.excludedGroups>
      </properties>
    </profile>

    <profile>
      <!-- Activated by the CI environment itself, not by remembering -Pci.
           Explicit -Pci still works and is what the acceptance check uses. -->
      <id>ci</id>
      <activation>
        <property>
          <name>env.CI</name>
          <!-- On the value, not the presence: CI=false must not activate it. -->
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-ci-rules</id>
                <phase>validate</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <!-- A <repositories> block in a POM means artifacts can
                         arrive from somewhere the organisation's mirror never
                         saw. Tolerable on a laptop, not in a build whose
                         inputs have to be auditable. -->
                    <requireNoRepositories>
                      <message>
                        Declare no repositories in a POM. CI resolves through
                        the configured mirror so that every input is
                        accounted for.
                      </message>
                    </requireNoRepositories>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
