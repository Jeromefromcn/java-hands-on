<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.jerome.slledger</groupId>
  <artifactId>sl-ledger-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Securities Lending Ledger</name>
  <description>
    A securities-lending ledger, built one stage at a time to exercise Java,
    Spring and the JVM. Aggregator and single source of dependency versions.
  </description>

  <modules>
    <module>domain</module>
    <module>application</module>
    <module>adapter-persistence</module>
    <module>adapter-web</module>
    <module>batch</module>
    <module>bootstrap</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Java 21 LTS. Virtual threads and pattern matching are stable here;
         Java 25 features are exercised separately in stage 8. -->
    <maven.compiler.release>21</maven.compiler.release>

    <!-- The Spring Boot BOM is imported, never inherited as a parent POM:
         in a regulated environment the parent POM is the organisation's own,
         so importing is the only shape that survives contact with reality. -->
    <spring-boot.version>4.1.1</spring-boot.version>

    <!-- Every plugin version is pinned here. An unpinned plugin resolves
         RELEASE from central, so the build changes when someone else ships,
         and the recorded jar checksums stop meaning anything. -->
    <maven-clean-plugin.version>3.4.1</maven-clean-plugin.version>
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    <maven-site-plugin.version>3.21.0</maven-site-plugin.version>
    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    <spotless.version>3.10.2</spotless.version>
    <google-java-format.version>1.36.1</google-java-format.version>

    <!-- Fixed timestamp for reproducible builds: two clean packages must
         produce byte-identical jars. Verified in section 8. -->
    <project.build.outputTimestamp>2026-09-20T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <!-- The single source of every version, internal and third-party alike.
       Child POMs declare dependencies without a <version>. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>adapter-persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>adapter-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>batch</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>bootstrap</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven-site-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <compilerArgs>
              <!-- Every warning the compiler has, and no warning survives a
                   build: a warning nobody fails on is a warning nobody reads. -->
              <arg>-Xlint:all</arg>
              <arg>-Werror</arg>
            </compilerArgs>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
          <executions>
            <execution>
              <id>enforce-build-rules</id>
              <phase>validate</phase>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <rules>
                  <requireJavaVersion>
                    <version>[21,22)</version>
                    <message>
                      Build with JDK 21. A newer JDK is not a drop-in here:
                      stage 8 compares a newer JVM against this baseline, so
                      the baseline has to stay fixed.
                    </message>
                  </requireJavaVersion>
                  <requireMavenVersion>
                    <!-- Upper bound on purpose: Maven 4 changes the default
                         lifecycle plugin versions, which moves the artifacts
                         this stage measured. -->
                    <version>[3.9.0,4.0.0)</version>
                  </requireMavenVersion>
                  <requirePluginVersions>
                    <banLatest>true</banLatest>
                    <banRelease>true</banRelease>
                    <banSnapshots>true</banSnapshots>
                  </requirePluginVersions>
                  <requireReleaseDeps>
                    <message>No SNAPSHOT dependencies.</message>
                    <!-- This project's own modules are a SNAPSHOT until it
                         releases; the rule is about depending on someone
                         else's moving target. -->
                    <excludes>
                      <exclude>${project.groupId}:*</exclude>
                    </excludes>
                  </requireReleaseDeps>
                  <dependencyConvergence />
                  <banDuplicatePomDependencyVersions />
                </rules>
                <fail>true</fail>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <googleJavaFormat>
                <version>${google-java-format.version}</version>
              </googleJavaFormat>
              <removeUnusedImports />
              <importOrder />
            </java>
          </configuration>
          <executions>
            <execution>
              <!-- Bound to validate, not left as a goal someone remembers to
                   run: a formatting rule that only fires on request is a
                   suggestion. -->
              <id>spotless-check</id>
              <phase>validate</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- The default. It carries nothing yet on purpose: a profile that
           exists to look symmetrical is a place for differences to hide.
           It is here so that `local` is a name the build knows, and so
           local-only conveniences have somewhere to land later. -->
      <id>local</id>
      <activation>
        <!-- Not activeByDefault: Maven switches that off the moment any other
             profile in this POM activates, which would make this profile
             disappear exactly when someone finally puts something in it. -->
        <property>
          <name>env.CI</name>
          <!-- Anything that is not exactly true, including CI being unset. -->
          <value>!true</value>
        </property>
      </activation>
    </profile>

    <profile>
      <!-- Activated by the CI environment itself, not by remembering -Pci.
           Explicit -Pci still works and is what the acceptance check uses. -->
      <id>ci</id>
      <activation>
        <property>
          <name>env.CI</name>
          <!-- On the value, not the presence: CI=false must not activate it. -->
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-ci-rules</id>
                <phase>validate</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <!-- A <repositories> block in a POM means artifacts can
                         arrive from somewhere the organisation's mirror never
                         saw. Tolerable on a laptop, not in a build whose
                         inputs have to be auditable. -->
                    <requireNoRepositories>
                      <message>
                        Declare no repositories in a POM. CI resolves through
                        the configured mirror so that every input is
                        accounted for.
                      </message>
                    </requireNoRepositories>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
