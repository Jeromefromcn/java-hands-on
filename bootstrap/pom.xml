<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.jerome.slledger</groupId>
    <artifactId>sl-ledger-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>bootstrap</artifactId>
  <name>Bootstrap</name>
  <description>The runnable application: wires every module together.</description>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>adapter-persistence</artifactId>
    </dependency>
    <!-- Stage 6: the application has a DataSource now. Runtime scope: no
         code compiles against the driver. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>adapter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>batch</artifactId>
    </dependency>

    <!-- The container itself, stage 4. spring-boot-starter-validation adds
         Bean Validation for @ConfigurationProperties + @Validated. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- The one module with every other module on its compile classpath
         (transitively, via adapter-persistence -> application -> domain,
         plus adapter-web and batch directly), so it is where a rule about
         the whole package tree can be checked. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Stage 7: spring-web and jakarta.servlet-api used to be declared here at
         test scope, for stage 4's request-scope demo. adapter-web now brings
         both at compile scope, and a direct test-scoped declaration would win
         nearest-first mediation and take them off the runtime classpath, the
         same trap stage 6 hit with spring-boot-starter-jdbc. The web tests call
         the server through spring-test's RestTestClient. -->
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>swagger-request-validator-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Stage 5: transaction and AOP demos against a real Postgres.
         spring-boot-starter-aspectj is Boot 4's name for Boot 3's
         spring-boot-starter-aop.
         spring-boot-starter-jdbc is deliberately NOT declared here any more:
         adapter-persistence brings it at compile scope, and a direct
         test-scoped declaration wins Maven's nearest-first mediation, which
         left HikariCP off the runtime classpath. Every test passed and the
         application could not start (docs/evidence/06-bootstrap-run.txt). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aspectj</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- SharedPostgres lives in adapter-persistence's tests since stage 6. -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>adapter-persistence</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- The only module with a Failsafe-bound rule in this stage. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <plugin>
        <!-- Default repackage goal only; not invoked by verify in stage 4,
             used ad hoc via spring-boot:run and wired for real in stage 14. -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
