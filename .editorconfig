# Formatting is enforced by Spotless with google-java-format; this file only
# keeps editors from fighting it before the build gets a chance to.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 2
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
max_line_length = 80

[Makefile]
indent_style = tab
