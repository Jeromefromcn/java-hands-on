# Stage 14: a production-like run: as staging, plus a config/ directory mounted next to the
# application (infra/delivery/envs/prod-config), which is how a setting that is not a secret and
# not one variable (a pool size, a whole block) reaches the image. It also names the environment.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8096
MANAGEMENT_SERVER_PORT=8196
LEDGER_MARKETDATA_URL=http://127.0.0.1:8089
LEDGER_JWT_ISSUER=http://127.0.0.1:8180/realms/ledger
LEDGER_JWK_SET_URI=http://127.0.0.1:8180/realms/ledger/protocol/openid-connect/certs
LEDGER_OTLP_TRACES_URL=http://127.0.0.1:4318/v1/traces
