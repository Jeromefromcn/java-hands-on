# Stage 14: a staging environment on this machine: the prod profile (JSON logs, management on its own
# port, production rate bounds, the real market-data client) against infra/compose.yaml's services.
# The prod profile names no database and no Redis: the environment does, here.
SPRING_PROFILES_ACTIVE=prod
INFO_APP_ENVIRONMENT=staging
SERVER_PORT=8095
MANAGEMENT_SERVER_PORT=8195
LEDGER_MARKETDATA_URL=http://127.0.0.1:8089
LEDGER_JWT_ISSUER=http://127.0.0.1:8180/realms/ledger
LEDGER_JWK_SET_URI=http://127.0.0.1:8180/realms/ledger/protocol/openid-connect/certs
LEDGER_OTLP_TRACES_URL=http://127.0.0.1:4318/v1/traces
