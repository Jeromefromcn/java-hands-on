# Stage 14: the developer environment, as an environment file for `docker run --env-file`.
# Non-secret settings only; infra/delivery/three-envs.sh passes the secrets from its caller's
# environment by name. The local profile reads LEDGER_DB_URL and LEDGER_REDIS_PASSWORD.
SPRING_PROFILES_ACTIVE=local
INFO_APP_ENVIRONMENT=dev
SERVER_PORT=8094
