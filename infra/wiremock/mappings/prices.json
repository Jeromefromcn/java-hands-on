{
  "mappings": [
    {
      "request": { "method": "GET", "urlPathPattern": "/prices/HK[A-Z0-9]{10}" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "isin": "{{request.path.[1]}}",
          "price": { "amount": "41.30", "currency": "HKD" }
        },
        "transformers": ["response-template"]
      }
    },
    {
      "request": { "method": "GET", "urlPathPattern": "/prices/US[A-Z0-9]{10}" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "isin": "{{request.path.[1]}}",
          "price": { "amount": "10.05", "currency": "USD" }
        },
        "transformers": ["response-template"]
      }
    }
  ]
}
